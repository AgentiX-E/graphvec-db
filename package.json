{
  "name": "agentiX-graphvec",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "AgentiX GraphVec — Globally distributed, multi-active graph database for AI Agent era",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(algorithms|api|import|index|materialized-view|ops|query|security|utils)' --testPathIgnorePatterns='rest|integration'",
    "test:core": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='src/core' --testPathIgnorePatterns='(multi-leader|event-bus|worker-pool|outbox-peerdb|benchmark)'",
    "test:eventbus": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(event-bus|event-stream)' --testPathIgnorePatterns='(extreme|edge|live|benchmark)'",
    "test:eventbus-live": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='event-bus.live'",
    "test:eventbus-edge": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='event-bus-edge'",
    "test:multileader": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='multi-leader' --testPathIgnorePatterns='(extreme|benchmark|edge)'",
    "test:multileader-extreme": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='multi-leader-extreme'",
    "test:multileader-edge": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='multi-leader-edge'",
    "test:multileader-benchmark": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='multi-leader-benchmark'",
    "test:workerpool": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='worker-pool'",
    "test:outbox": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(outbox|replication|segment|stream-wal)' --testPathIgnorePatterns='multi-leader|dc|delta|hlc|membership|cdc'",
    "test:replication": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(dc-sync|delta-sync|hlc|membership|cdc)'",
    "test:consensus": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='consensus' --testPathIgnorePatterns='(raft-logic|raft-integration|raft-install|raft-transport)'",
    "test:raft": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(raft-logic|raft-integration|raft-install|raft-transport)'",
    "test:reshard": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='reshard'",
    "test:shard-core": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(auto-splitter|shard-router)'",
    "test:shard-cluster": "NODE_OPTIONS='--max-old-space-size=4096' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(shard-manager|range-instance|rebalancer)'",
    "test:shard-routing": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(scatter-gather|edge-affinity)'",
    "test:shard-stability": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='(shard-health|shard-dual)'",
    "test:security": "NODE_OPTIONS='--max-old-space-size=3072' jest --runInBand --forceExit --no-coverage --config jest.no-coverage.config.ts --testPathPattern='security'",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:fault": "jest --config jest.fault-injection.config.ts --verbose",
    "test:all": "npm run test:unit && npm run test:core && npm run test:eventbus && npm run test:eventbus-live && npm run test:eventbus-edge && npm run test:multileader && npm run test:multileader-edge && npm run test:outbox && npm run test:workerpool && npm run test:replication && npm run test:consensus && npm run test:reshard && npm run test:shard-core && npm run test:shard-cluster && npm run test:shard-routing && npm run test:shard-stability && npm run test:security && npm run test:multileader-extreme && npm run test:multileader-benchmark && npm run test:raft",
    "test:all:coverage": "NODE_OPTIONS='--max-old-space-size=4096' jest --maxWorkers=1 --coverage --forceExit",
    "bench": "npx ts-node bench/core-ops.bench.ts",
    "dev": "ts-node scripts/dev-cluster.ts",
    "lint": "eslint src/ --ext .ts",
    "preinstall": "node scripts/verify-deps.mjs",
    "verify-deps": "node scripts/verify-deps.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@consento/hlc": "^2.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "archiver": "^8.0.0",
    "chokidar": "^5.0.0",
    "consistent-hashing": "^0.3.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-dag": "^0.4.1",
    "graphology-metrics": "^2.4.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "lmdb": "^3.5.4",
    "lru-cache": "^11.0.0",
    "minisearch": "^7.2.0",
    "msgpackr": "^2.0.1",
    "node-cron": "^4.2.1",
    "overgraph": "^0.7.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rotating-file-stream": "^3.2.9",
    "tar": "^7.5.15",
    "uuid": "^10.0.0",
    "xxhash-wasm": "^1.1.0",
    "zeromq": "^6.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "raft-logic": "^0.3.14"
  }
}
