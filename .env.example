# AgentiX GraphVec — Environment Configuration

# Storage
DATA_DIR=./data
VIEW_DIR=./data/views
BACKUP_DIR=./backups

# Raft Consensus
RAFT_ELECTION_TIMEOUT_MIN=150
RAFT_ELECTION_TIMEOUT_MAX=300
RAFT_HEARTBEAT_INTERVAL=50

# Security
AUTH_MODE=jwt
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MS=3600000

# Cross-DC Replication
DC_ID=dc-1
ZMQ_PUB_ADDRESS=tcp://0.0.0.0:5555
ZMQ_SUB_ADDRESS=tcp://0.0.0.0:5556
SYNC_INTERVAL_MS=100

# OpenTelemetry
OTEL_SERVICE_NAME=agentiX-graphvec
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logging
LOG_LEVEL=info
